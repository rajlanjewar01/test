# ──────────────────────────────────────────────
# bigdaddy – environment variables
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────

# Node
NODE_ENV=development

# API
API_PORT=3000
API_HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://bigdaddy:bigdaddy@localhost:5432/bigdaddy

# Redis
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug

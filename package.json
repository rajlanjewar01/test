{
	"name": "bigdaddy",
	"version": "0.0.0",
	"private": true,
	"description": "Heavy-equipment service information system (portfolio project, synthetic data only).",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"node": ">=25",
		"npm": ">=10"
	},
	"scripts": {
		"prepare": "husky",
		"test": "npm run test --workspaces --if-present",
		"test:coverage": "npm run test:coverage --workspaces --if-present",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"lint:openapi": "spectral lint apps/api/openapi/openapi.yaml --ruleset .spectral.yaml --fail-severity error",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run lint && npm run lint:openapi && npm run format:check && npm test"
	},
	"devDependencies": {
		"@bigdaddy/config": "*",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"@stoplight/spectral-cli": "^6.17.0",
		"@vue/test-utils": "^2.5.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.17.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"typescript-eslint": "^8.72.1"
	}
}
